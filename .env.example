# CareerPilot AI - Environment API Keys Configuration (Optional Defaults)

# Groq API Key (For ultra-fast Llama 3.3 Resume Content Ranking & Overleaf LaTeX generation)
# Get free key from: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (For AI Email Drafting & Copilot assistant)
# Get free key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud OAuth Credentials (For Gmail API auto-sync and live email dispatch)
# Configure from: https://console.cloud.google.com
VITE_GMAIL_CLIENT_ID=your_google_client_id_here
VITE_GMAIL_CLIENT_SECRET=your_google_client_secret_here
